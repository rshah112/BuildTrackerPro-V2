# Never upload local env files. Configure VITE_SUPABASE_URL and
# VITE_SUPABASE_ANON_KEY explicitly in each Vercel environment; production builds
# fail closed when either is missing.
.env
.env.*
!.env.example

# Local-only artifacts
.vercel
dist
test-results
playwright-report
node_modules
supabase/.branches
supabase/.temp
