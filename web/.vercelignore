# Never upload local env to Vercel — the production build uses the baked-in
# fallback in src/lib/supabase.ts (public URL + anon key). Uploading .env would
# override it with the local stack URL.
.env
.env.*
!.env.example

# Local-only artifacts
.vercel
dist
test-results
playwright-report
node_modules
supabase/.branches
supabase/.temp
