# Supabase (client-safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server-only — Vercel env / local .env, never shipped to client)
# API functions may use these aliases; otherwise they use the matching VITE values above.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=

# Web Push (public key is safe for the client; private key and cron secret are server-only)
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=

# Local seeded/e2e account (no fixed credentials are stored in source)
E2E_EMAIL=
E2E_PASSWORD=

# Cloudflare R2 (server-only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cloudflare Workers AI OCR (server-only)
# CF_ACCOUNT_ID may be omitted when OCR and R2 use the same R2_ACCOUNT_ID above.
# The Meta Llama 3.2 vision license must be accepted once for the Cloudflare account.
CF_ACCOUNT_ID=
CF_AI_TOKEN=

# Optional OCR safety/budget overrides (shown with application defaults)
OCR_MAX_FILE_BYTES=3000000
OCR_REQUESTS_PER_MINUTE=8
OCR_REQUESTS_PER_DAY=60
OCR_DAILY_INPUT_BYTES=120000000
OCR_MAX_CONCURRENT_PER_USER=2
OCR_QUOTA_TIMEOUT_MS=4000
OCR_MODEL_TIMEOUT_MS=20000
OCR_MAX_PDF_PAGES=20
OCR_MIN_PDF_TEXT_CHARS=80
OCR_MAX_PDF_TEXT_CHARS=12000
OCR_PDF_RENDER_WIDTH=1600
OCR_MAX_PDF_RENDER_PIXELS=4000000
OCR_MAX_RENDERED_PDF_BYTES=6000000

# Local dev: set to "1" to route blob uploads to a local stub dir instead of R2
VITE_R2_LOCAL=
