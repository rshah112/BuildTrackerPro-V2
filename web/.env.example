# Supabase (client-safe)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase (server-only — Vercel env / local .env, never shipped to client)
SUPABASE_SERVICE_ROLE=

# Cloudflare R2 (server-only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Local dev: set to "1" to route blob uploads to a local stub dir instead of R2
VITE_R2_LOCAL=
